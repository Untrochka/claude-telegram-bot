# Скопируй в .env и заполни

# Токен бота от @BotFather (создай нового бота, "New Bot")
BOT_TOKEN=

# Твой Telegram user id — бот игнорирует Business-подключения и личные
# сообщения от всех, кроме этого id (узнать свой id у @userinfobot)
OWNER_TELEGRAM_ID=

# Режим генерации ответов:
#   subscription — бесплатно, использует твою Claude Pro подписку через Claude Code CLI
#                   (нужно один раз выполнить `claude` в терминале и залогиниться)
#   api          — платно по токенам через Anthropic API (копейки за сообщение, см. README)
CLAUDE_MODE=subscription

# Нужен только если CLAUDE_MODE=api
ANTHROPIC_API_KEY=

# Модель для режима api (для subscription используется модель твоей подписки)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Сколько последних сообщений из переписки давать боту как контекст
HISTORY_LIMIT=10

# Каналы для /day (дневной разбор -> посты). @username для публичных,
# для приватных — numeric id (переслать сообщение из канала @userinfobot)
UNTRA_CHANNEL_ID=@untra_dev
VLOG_CHANNEL_ID=@untra_dev_vlog
