# Скопируй в .env и заполни

# Токен бота от @BotFather (создай нового бота, "New Bot")
BOT_TOKEN=

# Твой Telegram user id — бот игнорирует Business-подключения и личные
# сообщения от всех, кроме этого id (узнать свой id у @userinfobot)
OWNER_TELEGRAM_ID=

# Режим генерации ответов:
#   subscription — бесплатно, использует твою Claude Pro подписку через Claude Code CLI
#                   (нужно один раз выполнить `claude` в терминале и залогиниться)
#   api          — платно по токенам через Anthropic API (копейки за сообщение, см. README)
CLAUDE_MODE=subscription

# Нужен только если CLAUDE_MODE=api
ANTHROPIC_API_KEY=


# Сколько последних сообщений из переписки давать боту как контекст
HISTORY_LIMIT=10

# Каналы для /day (дневной разбор -> посты). @username для публичных,
# для приватных — numeric id (переслать сообщение из канала @userinfobot)
UNTRA_CHANNEL_ID=@untra_dev
VLOG_CHANNEL_ID=@untra_dev_vlog

# Автоответчик клиентам: некоторые типовые ответы отправляются автоматически
# без подтверждения (см. CLAUDE_CODE_TASK.md). Можно переключать на лету
# командой /auto on / /auto off, не трогая .env.
# Если строку убрать/оставить пустой — считается true (включено).
AUTO_SEND_ENABLED=true

# Какие intent отправлять автоматически, через запятую без пробелов.
# autoreply никогда не отправляется автоматически (только уведомление).
# redirect, interested, urgent, other — всегда только черновик на утверждение.
AUTO_SEND_INTENTS=refusal,soft_no,price,examples

# true — ничего не отправлять клиентам по-настоящему (ни автоответ, ни ручное
# подтверждение ✅), только логировать и писать владельцу, что было бы
# отправлено. Держать true при любом тестировании.
DRY_RUN=true

# Расшифровка голосовых и звука из видео (Groq Whisper, бесплатный лимит).
# Ключ: https://console.groq.com/keys . Пусто — голосовые не расшифровываются,
# бот просто сообщает о них, как раньше.
GROQ_API_KEY=
# Дешёвый LLM (llm.js): простые задачи идут в Groq, при лимите/сбое — в Claude.
# GROQ_FAST_MODEL=llama-3.1-8b-instant
# GROQ_SMART_MODEL=llama-3.3-70b-versatile

# Модель одна на всё (и subscription, и api). Effort по умолчанию для всех ролей
# (low|medium|high|xhigh|max); по ролям меняется на лету: /model <роль> <effort>.
BOT_CLAUDE_MODEL=claude-opus-5-5
BOT_CLAUDE_EFFORT=low

# /day выключается сам, если столько часов не было сообщений.
DAY_IDLE_HOURS=3

# Сколько сообщений хранить на каждый чат (для Рафаэля и анализа переписок).
CHAT_STORE_LIMIT=300

# --- MTProto: бот работает и от твоего аккаунта (чтение всех чатов, агент комментариев) ---
# 1) https://my.telegram.org → API development tools → создай приложение → API_ID и API_HASH.
# 2) Один раз: TG_API_ID=... TG_API_HASH=... npm run mtproto:login  → телефон, код, 2FA → строка сессии.
# 3) Строку положи в TG_SESSION (в Coolify — как секрет). Это ПОЛНЫЙ доступ к аккаунту:
#    никому не показывать, не коммитить, не отправлять в чаты.
# Пусто — бот работает как раньше, без чтения чатов и без агента комментариев.
TG_API_ID=
TG_API_HASH=
TG_SESSION=

# --- Агент комментариев в Telegram ---
# Черновики приходят тебе на ✅, сам бот ничего не отправляет. Лимиты — защита аккаунта от спам-блока.
COMMENTS_ENABLED=true
WATCH_MAX=20
COMMENT_DRAFTS_PER_DAY=15
MAX_COMMENTS_PER_DAY=10
MAX_JOINS_PER_DAY=4
WATCH_POLL_MINUTES=12

# --- Напоминания про посты и комментарии (Telegram, Contra, LinkedIn, Reddit) ---
PLANNER_ENABLED=true

# --- Система untra (дверь для Claude/GPT и бэкап) ---
# Токены доступа: "кто:секрет", через запятую, секрет минимум 24 символа (сгенерировать: openssl rand -hex 24)
MCP_TOKENS=
MCP_PORT=8787
# Ночной бэкап: https://<github-token>@github.com/Untrochka/untra-backup.git (token: fine-grained, только этот репо, Contents: read/write)
BACKUP_REPO_URL=
# Где лежат система и CRM (должна быть постоянным томом в Coolify)
UNTRA_DATA_DIR=/app/data
